RUN: %lldb --help | FileCheck %s
RUN: cat %S/../../../docs/man/lldb.rst | FileCheck %s

# The CHECK lines below only prove that both list these options. Also check
# that lldb.rst documents exactly the options lldb accepts, in both directions.
RUN: %lldb --help > %t.help
RUN: %python %S/Inputs/check-man-page-options.py %S/../../../docs/man/lldb.rst %t.help

RUN: echo '.. option:: --replay <filename>' > %t.stale.rst
RUN: cat %S/../../../docs/man/lldb.rst >> %t.stale.rst
RUN: not %python %S/Inputs/check-man-page-options.py %t.stale.rst %t.help \
RUN:   | FileCheck %s --check-prefix=STALE
STALE: error: lldb.rst documents --replay, which lldb does not accept

CHECK: ATTACHING
CHECK: --attach-name
CHECK: --attach-pid
CHECK: -n <value>
CHECK: -p <value>
CHECK: --wait-for
CHECK: -w

CHECK: COMMANDS
CHECK: --batch
CHECK: -b
CHECK: -K <value>
CHECK: -k <value>
CHECK: --local-lldbinit
CHECK: --no-lldbinit
CHECK: --one-line-before-file
CHECK: --one-line-on-crash
CHECK: --one-line
CHECK: -O
CHECK: -o
CHECK: -Q
CHECK: --source-before-file
CHECK: --source-on-crash
CHECK: --source-quietly
CHECK: --source
CHECK: -S
CHECK: -s
CHECK: -x

CHECK: OPTIONS
CHECK: --arch
CHECK: -a
CHECK: --core
CHECK: -c
CHECK: --editor
CHECK: -e
CHECK: --file
CHECK: -f
CHECK: --help
CHECK: -h
CHECK: --no-use-colors
CHECK: --version
CHECK: -v
CHECK: -X

CHECK: REPL
CHECK: -r
CHECK: --repl-language
CHECK: --repl
CHECK: -R
CHECK: -r

CHECK: SCRIPTING
CHECK: -l
CHECK: --print-script-interpreter-info
CHECK: --python-path
CHECK: -P
CHECK: --script-language
