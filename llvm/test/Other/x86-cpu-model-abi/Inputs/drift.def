X86_VENDOR(VENDOR_INTEL, "intel")
X86_VENDOR(VENDOR_AMD,   "amd")
X86_VENDOR(VENDOR_HYGON, "hygon")

X86_CPU_TYPE(INTEL_BONNELL, "bonnell")
X86_CPU_TYPE(INTEL_CORE2,   "core2")

X86_CPU_SUBTYPE(INTEL_COREI7_NEHALEM,  "nehalem")
X86_CPU_SUBTYPE(INTEL_COREI7_NEWLAKE,  "newlake")
X86_CPU_SUBTYPE(INTEL_COREI7_WESTMERE, "westmere")

X86_FEATURE_COMPAT(CMOV,  "cmov",  0, 0)
X86_FEATURE_COMPAT(MMX,   "mmx",   1, 2)
X86_FEATURE_COMPAT(SSE,   "sse",   2, 2)
X86_FEATURE_COMPAT(SAHF,  "sahf",  0, 54)
X86_FEATURE_COMPAT(NEWF,  "newf",  0, 130)
