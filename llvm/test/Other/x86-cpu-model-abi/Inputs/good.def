#ifndef X86_VENDOR
#define X86_VENDOR(ENUM, STR)
#endif
X86_VENDOR(VENDOR_INTEL, "intel")
X86_VENDOR(VENDOR_AMD,   "amd")
#undef X86_VENDOR

#ifndef X86_CPU_TYPE
#define X86_CPU_TYPE(ENUM, STR)
#endif
X86_CPU_TYPE(INTEL_BONNELL, "bonnell")
X86_CPU_TYPE(INTEL_CORE2,   "core2")
X86_CPU_TYPE_ALIAS(INTEL_BONNELL, "atom")

#ifndef X86_CPU_SUBTYPE
#define X86_CPU_SUBTYPE(ENUM, STR)
#endif
X86_CPU_SUBTYPE(INTEL_COREI7_NEHALEM,  "nehalem")
X86_CPU_SUBTYPE(INTEL_COREI7_WESTMERE, "westmere")
X86_CPU_SUBTYPE_ALIAS(INTEL_COREI7_NEHALEM, "foo")

#ifndef X86_FEATURE_COMPAT
#define X86_FEATURE_COMPAT(ENUM, STR, PRIORITY, ABI_VALUE) X86_FEATURE(ENUM, STR)
#endif
X86_FEATURE_COMPAT(CMOV,  "cmov",  0, 0)
X86_FEATURE_COMPAT(MMX,   "mmx",   1, 1)
X86_FEATURE_COMPAT(ADX,   "adx",
                   0, 40) // Spans lines.
X86_FEATURE_COMPAT(SAHF,  "sahf",  0, 54)
X86_FEATURE_COMPAT(64BIT, "64bit", 0, 55) // Also known as "LM"
X86_MICROARCH_LEVEL(X86_64_BASELINE, "x86-64", 0, 95)
X86_FEATURE       (CMPXCHG8B, "cx8")
